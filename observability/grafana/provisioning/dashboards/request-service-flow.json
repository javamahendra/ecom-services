      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (service) (count_over_time({service=~\"$service\"} |= \"$traceId\" |= \"$spanId\" |= \"$orderId\" |= \"$userId\" |~ \"(?i)$level\" |= \"$search\" [$__interval]))",
          "legendFormat": "{{service}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Log activity by service",
      "type": "timeseries"
