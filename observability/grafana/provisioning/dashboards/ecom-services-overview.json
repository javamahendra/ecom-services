      "pluginVersion": "11.5.2",
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(http_server_requests_seconds_count{job=\"api-gateway\",uri=\"/api/users\",method=\"POST\",status=~\"2..\"}[$__range]))",
          "legendFormat": "Self registrations",
          "refId": "A"
        }
      ],
      "title": "Registrations (successful requests)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Successful Kafka producer and consumer observations by service. Available when Spring Kafka observation metrics are emitted.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "11.5.2",
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (job) (rate(spring_kafka_template_seconds_count{job=~\"$job\"}[5m]))",
          "legendFormat": "sent {{job}}",
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum by (job) (rate(spring_kafka_listener_seconds_count{job=~\"$job\"}[5m]))",
          "legendFormat": "processed {{job}}",
          "refId": "B"
        }
      ],
      "title": "Kafka send and consume activity",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Request rate by service and route, showing synchronous application flows through the gateway and services.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "11.5.2",
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (job, uri) (rate(http_server_requests_seconds_count{job=~\"$job\",uri!~\"UNKNOWN|/actuator/.*\"}[5m]))",
          "legendFormat": "{{job}} {{uri}}",
          "refId": "A"
        }
      ],
      "title": "HTTP service flows (requests per second)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Non-success HTTP responses by service and status code, including login failures.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "id": 8,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "11.5.2",
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (job, status) (rate(http_server_requests_seconds_count{job=~\"$job\",status=~\"4..|5..\"}[5m]))",
          "legendFormat": "{{job}} HTTP {{status}}",
          "refId": "A"
        }
      ],
      "title": "HTTP errors",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Recent logs from all services. Use trace IDs in the log line to correlate with Tempo traces.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 9,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "pluginVersion": "11.5.2",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{service=~\".+\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Service logs",
      "type": "logs"
    },
